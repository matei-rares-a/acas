flowchart TD
    A([Start]) --> B["User enters\nusername · password · server URL"]
    C --> D["GET /parameters\nReceive P, G  (Q = (P-1)/2 computed client-side)"]
    C --> D["Derive private key\nx = scrypt(password, salt) mod Q"]
    D --> E["Generate random r ←$ [1, Q-1]\nusing CSPRNG"]
    E --> F["Compute commitment\nt = G^r mod P"]
    F --> G["POST /login/commit\n{ client_id, commitment_t = t }"]
    G --> H{Response?}
    H -- "400 Bad Request" --> H400["❌ Missing client_id or commitment_t"]
    H -- "404 Not Found" --> I["❌ User not registered"]
    H -- "409 Conflict" --> J["❌ Existing commitment found\nStart a new session"]
    H -- "422 Unprocessable" --> K["❌ t is not a valid\nsubgroup member"]
    H -- "200 OK" --> L["Receive challenge_c = c, session_id\nc is hash-bound to session and binding"]
    L --> M["Compute response\ns = r + c·x mod Q"]
    M --> N["POST /login/verify\nheader X-Auth-Session: session_id\n{ solution_s = s }"]
    N --> O["Server checks binding and challenge integrity\nVerifies G^s = t · y^c mod P"]
    O --> P{Verification result}
    P -- "401 Session Expired" --> R300["❌ Session TTL exceeded\n(commit → verify too slow)"]
    P -- "422 Out of Range" --> R422["❌ solution_s out of range\ns must be in 0 to Q"]
    P -- "401 Binding Mismatch" --> R401b["❌ Request came from a different\nnetwork path (relay / MitM detected)"]
    P -- "400 Integrity Failed" --> R400["❌ Challenge integrity check failed\n(session tamper detected)"]
    P -- "✓ Proof valid" --> Q["Receive JWT token\n{ token }"]
    P -- "✗ Proof invalid - 401" --> R["❌ Verification failed\n(wrong password or tampered proof)"]
    Q --> S["✅ Authenticated\nStore token, display success"]
    I & J & K & H400 & R300 & R422 & R401b & R400 & R --> T["Show error message\nReturn to login form"]
    S & T --> Z([End])
