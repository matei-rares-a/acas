erDiagram
    USER {
        int     id         PK
        string  client_id  UK
        bytes   secret_y
        datetime created_at
    }

    AUTH_TOKEN {
        int     id         PK
        int     user_id    FK
        string  token      UK
        datetime created_at
    }

    PERSO_DATA {
        int     id         PK
        int     user_id    FK
        string  message    UK
    }

    USER ||--o| AUTH_TOKEN : "has (at most 1 active token)"
    USER ||--o| PERSO_DATA : "has (at most 1 data record)"
