{
  "manifest_version": 3,
  "name": "My Hi Extension",
  "version": "1.0",
  "description": "A simple popup extension with a button.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Say Hi"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "storage"
  ],
  
    "host_permissions": [
        "<all_urls>"
    ]
}
